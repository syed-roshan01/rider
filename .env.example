# Vercel environment variables for the Ride Accepter licence admin dashboard.
# NAMES ONLY -- never put real values in this file. Set values in the Vercel
# dashboard (Project Settings -> Environment Variables) or with `vercel env add`.
# Never name an admin env var NEXT_PUBLIC_*: that would ship it to the browser.

# Admin dashboard login password.
ADMIN_PASSWORD=

# Random 32+ bytes. HMAC key for the ra_admin session token (unforgeable expiry).
ADMIN_SESSION_SECRET=

# base64-encoded 32-byte key (e.g. openssl rand -base64 32). AES-256-GCM master
# key that seals licence keys in licenses.key_sealed so /reveal can unseal them.
MASTER_SEAL_KEY=

# Supabase project URL (Project Settings -> API).
SUPABASE_URL=

# Supabase service role key. Server-side only (api/); bypasses RLS. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# NOT USED HERE (do not set it in Vercel): LICENSE_SIGNING_PRIVATE lives solely
# in the Supabase Edge Function secrets. The admin surface never signs tokens.
