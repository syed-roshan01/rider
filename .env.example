# Vercel environment variables for the Ride Accepter licence admin dashboard.
# NAMES ONLY -- never put real values in this file. Set values in the Vercel
# dashboard (Project Settings -> Environment Variables) or with `vercel env add`.
# Never name an admin env var NEXT_PUBLIC_*: that would ship it to the browser.

# Admin dashboard login password.
ADMIN_PASSWORD=

# Random 32+ bytes. HMAC key for the ra_admin session token (unforgeable expiry).
ADMIN_SESSION_SECRET=

# base64-encoded 32-byte key (e.g. openssl rand -base64 32). AES-256-GCM master
# key that seals licence keys in licenses.key_sealed so /reveal can unseal them.
MASTER_SEAL_KEY=

# Supabase project URL (Project Settings -> API).
SUPABASE_URL=

# Supabase service role key. Server-side only (api/); bypasses RLS. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# NOT USED HERE (do not set it in Vercel): LICENSE_SIGNING_PRIVATE lives solely
# in the Supabase Edge Function secrets. The Admin surface never signs tokens.

# --- AcceptPro admin suite (panel users, whitelabel, affiliates, checkout) ---

# HS256 secret for the panel login JWT (roles super/admin/whitelabel/affiliate).
# A dev fallback exists but production MUST set this. openssl rand -hex 32.
JWT_SECRET=

# Seed super-admin created lazily on first login. Defaults: admin / changeme123.
# Set both before first login in production.
ADMIN_USERNAME=
# (password seed reuses ADMIN_PASSWORD above)

# Cashfree PG gateway (buy page + webhook). Absent => /api/checkout/create-order
# answers 503 'Online payment is not available right now.'
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Optional gateway base override; default sandbox/production by CASHFREE mode.
CASHFREE_BASE_URL=

# Resend transactional email (checkout key delivery). Absent => silently skip.
RESEND_API_KEY=
EMAIL_FROM=

# DEV/TEST ONLY: 1 = local fake payment gateway (no network calls). NEVER set
# this in production.
# CHECKOUT_FAKE_GATEWAY=
