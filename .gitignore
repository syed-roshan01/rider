# ---------------------------------------------------------------------------
# NEVER COMMIT THESE. They contain live secrets or re-creatable bulk data.
# ---------------------------------------------------------------------------

# Ed25519 signing keys, dev keys, keystores -- rotating these breaks every
# issued licence and lets anyone mint tokens.
license/keys/
*.keystore
*.jks
*.p12
*.b64

# The JSON licence store: key hashes, sealed keys, device bindings.
license/data/

# Credentials harvested from the APK during reverse engineering (Firebase
# API key, sender IDs, Paytm MID, etc). Re-creatable from the APK; must not
# be redistributed.
analysis/
decoded-jadx/
decoded-apktool/
*.apk
*.dex
*.idsig

# Build output
build/
dist/
out/
*.apk.idsig

# Tooling downloads (large, re-creatable)
tools/jadx/
tools/apktool*/

# Node / general
node_modules/
.npm/
.env
.env.*
!.env.example
*.local

# Vercel
.vercel/

# Logs and scratch
*.log
*.tmp
*.bak
*.orig
*.patched
scratch/
scratch-*

# OS noise
Thumbs.db
Desktop.ini
.DS_Store

# Editors
.vscode/
.idea/

# Raw extracted APK contents (third-party app content, re-creatable)
apk-raw/


# Tool downloads and scratch dumps
tools/jadx*.zip
tools/probe/

# Supabase CLI local metadata (may hold DB connection strings)
supabase/.temp/


.npm-cache/

